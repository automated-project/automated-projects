# 1. Ignore everything by default
*

# 2. Allow directories so git can traverse
!*/

# 3. Explicitly ALLOW ONLY Text/Code Source Files & Ch2 Audio
!*.py
!*.md
!*.yml
!*.yaml
!*.txt
!*.sh
!*.gitignore
!.github/**
!YouTube/02_Velvet_Sunset_Channel/raw_audio/ch2_drive_mp3/*.mp3
!YouTube/02_Velvet_Sunset_Channel/cover_art/thumb_03_golden_hour.jpg

# 4. EXCLUDE all other binary media, images, zips, weights, tokens, credentials
*.png
*.webp
*.mp4
*.wav
*.flac
*.zip
*.tar.gz
*.ttf
*.ttc
*.log
*.json
